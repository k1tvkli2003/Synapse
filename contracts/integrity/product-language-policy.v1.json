{
  "schemaVersion": 1,
  "policyId": "synapse.unified-functional-surface-naming.v1",
  "productName": "Synapse",
  "legacySource": "StudyHUB-Flutter",
  "capabilityLedger": "contracts/preservation/capability-ledger.v1.json",
  "legacyCapabilityIdPrefix": "studyhub.",
  "principles": [
    "Synapse is the only user-facing product and brand authority.",
    "Absorbed capabilities are named for the task they help the user complete.",
    "Legacy source names exist only in migration provenance, fixtures, adapters, and preservation contracts.",
    "No source-branded tab, page, workspace, notification channel, widget, accessibility label, search category, or analytics namespace may be created.",
    "Standalone Hub is not an accepted mapped surface name; use the actual domain or task."
  ],
  "scanGlobs": [
    "apps/app/lib/**",
    "apps/app/android/app/src/main/**",
    "apps/app/ios/Runner/**",
    "apps/app/macos/Runner/**",
    "apps/app/linux/runner/**",
    "apps/app/windows/runner/**",
    "apps/app/web/**",
    "packages/*/lib/**"
  ],
  "textSuffixes": [
    ".arb",
    ".c",
    ".cc",
    ".cmake",
    ".cpp",
    ".dart",
    ".h",
    ".hpp",
    ".html",
    ".java",
    ".js",
    ".json",
    ".kt",
    ".kts",
    ".m",
    ".mm",
    ".plist",
    ".properties",
    ".rc",
    ".strings",
    ".swift",
    ".ts",
    ".tsx",
    ".txt",
    ".xml",
    ".yaml",
    ".yml"
  ],
  "forbiddenRules": [
    {
      "id": "legacy-studyhub-brand",
      "pattern": "(?i)\\bstudy[ \\t_.-]*hub\\b",
      "message": "A legacy source brand escaped into a Synapse product surface."
    }
  ],
  "allowlist": [],
