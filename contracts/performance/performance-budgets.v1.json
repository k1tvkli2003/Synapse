{
  "schemaVersion": 1,
  "baseline": "luma-restoration-2026-07-17",
  "policy": {
    "staticEnforcement": "Deterministic artifact and asset measurements fail when a required probe is missing or empty, and fail size enforcement above blockingMaxBytes.",
    "runtimeEnforcement": "Device startup, frame, memory, power, and interaction budgets are informational until calibrated on representative physical hardware.",
    "calibration": {
      "minimumRepresentativeRuns": 10,
      "profileOrReleaseOnly": true,
      "physicalDeviceRequired": true,
      "promoteToBlockingWhen": "A named device profile has a reproducible baseline, controlled conditions, and at least ten representative runs."
    },
    "motionModes": [
      "full",
      "reduced",
      "off"
    ],
    "requiredMotionScenarios": [
      "first-run",
      "warm-run",
      "repeat",
      "interruption",
      "background-resume",
      "reduced-motion",
      "motion-off",
      "renderer-fallback"
    ]
  },
  "staticBudgets": [
    {
      "id": "web.release-output-total",
      "description": "Complete deployable Flutter Web release, including renderer alternatives and symbols.",
      "probe": {
        "type": "tree_bytes",
        "path": "apps/app/build/web"
      },
      "required": true,
      "enforcement": "blocking",
      "thresholdsBytes": {
        "targetMax": 58720256,
        "warningMax": 67108864,
        "blockingMax": 83886080
      }
    },
    {
      "id": "web.main-dart-js-raw",
      "description": "Uncompressed compiled application JavaScript.",
      "probe": {
        "type": "file_bytes",
        "path": "apps/app/build/web/main.dart.js"
      },
      "required": true,
      "enforcement": "blocking",
      "thresholdsBytes": {
        "targetMax": 4194304,
        "warningMax": 4980736,
        "blockingMax": 6291456
      }
    },
    {
      "id": "web.main-dart-js-gzip",
      "description": "Deterministic gzip-9 estimate for compiled application JavaScript; CDN Brotli is measured separately at release time.",
      "probe": {
        "type": "gzip_file_bytes",
        "path": "apps/app/build/web/main.dart.js"
      },
      "required": true,
      "enforcement": "blocking",
      "thresholdsBytes": {
        "targetMax": 1572864,
        "warningMax": 2097152,
        "blockingMax": 2621440
      }
    },
    {
      "id": "web.renderer-largest-wasm",
      "description": "Largest renderer WASM variant shipped in the web output.",
      "probe": {
        "type": "largest_file_bytes",
        "path": "apps/app/build/web/canvaskit",
        "extensions": [
          ".wasm"
        ]
      },
      "required": true,
      "enforcement": "blocking",
      "thresholdsBytes": {
        "targetMax": 8388608,
        "warningMax": 10485760,
        "blockingMax": 12582912
      }
    },
    {
      "id": "web.flutter-assets-total",
      "description": "All Flutter asset-bundle files emitted for web, including notices and fonts.",
      "probe": {
        "type": "tree_bytes",
        "path": "apps/app/build/web/assets"
      },
      "required": true,
      "enforcement": "blocking",
      "thresholdsBytes": {
        "targetMax": 10485760,
        "warningMax": 14680064,
        "blockingMax": 20971520
      }
    },
    {
      "id": "app.declared-flutter-assets-total",
      "description": "All app-owned source assets declared by the Flutter package and therefore eligible for bundling; historical undeclared evidence remains outside the shipping budget.",
      "probe": {
        "type": "flutter_declared_assets_bytes",
        "path": "apps/app/pubspec.yaml"
      },
      "required": true,
      "enforcement": "blocking",
      "thresholdsBytes": {
        "targetMax": 7340032,
        "warningMax": 10485760,
        "blockingMax": 14680064
      }
    },
    {
      "id": "identity.selected-companion-assets-total",
      "description": "Restored LUMA Character System and ICR2-01 LUMA Facefront assets available at runtime.",
      "probe": {
        "type": "tree_bytes",
        "path": "apps/app/assets/identity/luma_facefront"
      },
      "required": true,
      "enforcement": "blocking",
      "thresholdsBytes": {
        "targetMax": 7340032,
        "warningMax": 10485760,
        "blockingMax": 14680064
      }
    },
    {
      "id": "identity.selected-wordmark-assets-total",
      "description": "Selected WMR2-01 wordmark assets available at runtime.",
      "probe": {
        "type": "tree_bytes",
        "path": "apps/app/assets/identity/wordmark"
      },
      "required": true,
      "enforcement": "blocking",
      "thresholdsBytes": {
        "targetMax": 262144,
        "warningMax": 524288,
        "blockingMax": 1048576
      }
    },
    {
      "id": "identity.largest-raster-encoded",
      "description": "Largest individually bundled identity raster in encoded form.",
      "probe": {
        "type": "largest_file_bytes",
        "path": "apps/app/assets/identity/luma_facefront",
        "extensions": [
          ".png",
          ".jpg",
          ".jpeg",
          ".webp"
        ]
      },
      "required": true,
      "enforcement": "blocking",
      "thresholdsBytes": {
        "targetMax": 1048576,
        "warningMax": 1572864,
        "blockingMax": 2097152
      }
    },
    {
      "id": "identity.largest-raster-decoded-rgba",
      "description": "Worst-case RGBA decode allocation for the largest PNG dimensions.",
      "probe": {
        "type": "largest_png_decoded_rgba_bytes",
        "path": "apps/app/assets/identity/luma_facefront"
      },
      "required": true,
      "enforcement": "blocking",
      "thresholdsBytes": {
        "targetMax": 4194304,
        "warningMax": 8388608,
        "blockingMax": 16777216
      }
    },
    {
      "id": "motion.rive-total",
      "description": "Total compiled Rive rigs and state-machine assets after MVS-MOTION-01.",
      "probe": {
        "type": "tree_extension_bytes",
        "path": "apps/app/assets",
        "extensions": [
          ".riv"
        ]
      },
      "required": false,
      "enforcement": "blocking",
      "thresholdsBytes": {
        "targetMax": 3145728,
        "warningMax": 6291456,
        "blockingMax": 10485760
      }
    },
    {
      "id": "motion.rive-largest",
      "description": "Largest individual Rive file; complex rigs must be split or optimized before this ceiling.",
      "probe": {
        "type": "largest_file_bytes",
        "path": "apps/app/assets",
        "extensions": [
          ".riv"
        ]
      },
      "required": false,
      "enforcement": "blocking",
      "thresholdsBytes": {
        "targetMax": 1048576,
        "warningMax": 2097152,
        "blockingMax": 4194304
      }
    },
    {
      "id": "motion.fragment-shaders-total",
      "description": "Total authored Flutter fragment-shader source before toolchain compilation.",
      "probe": {
        "type": "tree_extension_bytes",
        "path": "apps/app/shaders",
        "extensions": [
          ".frag"
        ]
      },
      "required": false,
      "enforcement": "blocking",
      "thresholdsBytes": {
        "targetMax": 524288,
        "warningMax": 1048576,
        "blockingMax": 2097152
      }
    },
    {
      "id": "content.initial-bundled-pack-total",
      "description": "Curriculum scaffold bundled into the binary; lesson bodies remain forbidden in the current phase.",
      "probe": {
        "type": "tree_bytes",
        "path": "apps/app/assets/content_packs/initial"
      },
      "required": false,
      "enforcement": "blocking",
      "thresholdsBytes": {
        "targetMax": 2097152,
        "warningMax": 5242880,
        "blockingMax": 10485760
      }
    },
    {
      "id": "content.largest-download-pack",
      "description": "Largest independently downloadable course or media pack.",
      "probe": {
        "type": "largest_file_bytes",
        "path": "apps/app/assets/content_packs/downloadable",
        "extensions": [
          ".pack",
          ".zip",
          ".tar",
          ".zst"
        ]
      },
      "required": false,
      "enforcement": "blocking",
      "thresholdsBytes": {
        "targetMax": 26214400,
        "warningMax": 52428800,
        "blockingMax": 104857600
      }
    }
  ],
  "runtimeBudgets": {
