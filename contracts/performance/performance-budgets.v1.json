  "motionExperienceBudgets": {
    "standard": {
      "purpose": "Answer feedback, path progress, navigation continuity, and micro-rewards.",
      "durationMilliseconds": {
        "targetMax": 450,
        "warningMax": 650,
        "blockingMax": 900
      },
      "particles": {
        "targetMax": 80,
        "warningMax": 140,
        "blockingMax": 220
      },
      "inputBlockingAllowed": false
    },
    "milestone": {
      "purpose": "Lesson completion, streak repair, level-up, and meaningful mastery moments.",
      "durationMilliseconds": {
        "targetMax": 1400,
        "warningMax": 2200,
        "blockingMax": 3200
      },
      "particles": {
        "targetMax": 180,
        "warningMax": 300,
        "blockingMax": 450
      },
      "skippableAfterMilliseconds": 700
    },
    "showpiece": {
      "purpose": "Rare chapter, course, rank, or identity-defining celebrations in Study mode only.",
      "durationMilliseconds": {
        "targetMax": 3200,
        "warningMax": 4500,
        "blockingMax": 6000
      },
      "particles": {
        "targetMax": 300,
        "warningMax": 500,
        "blockingMax": 800
      },
      "skippableAfterMilliseconds": 800,
      "forbiddenInClinicalMode": true
    },
    "adaptation": {
      "full": "Use authored choreography within tier budgets and never delay persistence or navigation.",
      "reduced": "Replace camera travel, parallax, shake, large-scale zoom, and particle fields with short opacity/color/scale confirmation.",
      "off": "Render the final semantic state immediately; retain accessible text, haptics only when enabled, and reward receipts.",
      "lowTier": "Reduce particle count, blur, overdraw, shader passes, and Rive detail before reducing semantic feedback.",
      "fallback": "Every Rive or shader scene owns a deterministic frozen-pose or raster/procedural equivalent, including Linux and web renderer fallback."
    }
  },
  "namedJourneys": [
